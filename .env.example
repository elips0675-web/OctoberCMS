# Шаблон окружения. Копируется в .env, который в git не попадает.
# Значения ниже — локальные, для машины разработчика (Laragon).
# Секреты (SMTP, VAPID, токен бота, ключи платных сервисов) добавляются
# на этапах 5–7 и только в .env, не здесь.

APP_NAME="NLB"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nlb_october
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# SMTP у владельца нет: письма пишутся в storage/logs/laravel.log.
# Код обязан работать с реальным SMTP без правок — меняется только это значение.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="NLB"

# Web Push (этап 7): ключи генерирует tools/gen-vapid.php, в репозиторий не попадают.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# REST для внешней записи (этап 7): Bearer-токен, не заглушка из источника.
BOOKING_API_TOKEN=
