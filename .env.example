# Шаблон окружения. Копируется в .env, который в git не попадает.
# Значения — локальные, для машины разработчика (Laragon, PHP 8.3.30,
# MySQL 8.4.3). Секреты (SMTP, VAPID, токен бота) добавляются на этапах 5–7
# и только в .env, не здесь.

APP_NAME="Библиотека 2026"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=ru

ACTIVE_THEME=nlb
BACKEND_URI=/admin
BACKEND_TURBO_ROUTER=false
CMS_ROUTE_CACHE=false
CMS_ASSET_CACHE=false
CMS_SAFE_MODE=false
LINK_POLICY=detect
DEFAULT_FILE_MASK=775
DEFAULT_FOLDER_MASK=775
LOG_DEPRECATIONS=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nlb_october
DB_USERNAME=root
DB_PASSWORD=

LOG_CHANNEL=single
BROADCAST_DRIVER=log
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP у владельца нет: письма пишутся в storage/logs/laravel.log.
# Код обязан работать с реальным SMTP без правок — меняется только это значение.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@nlb.local
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Web Push (этап 7): ключи генерирует tools/gen-vapid.php, в репозиторий не попадают.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# REST для внешней записи (этап 7): Bearer-токен, не заглушка из источника.
BOOKING_API_TOKEN=
